EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_RC_APPLE_KEY=
EXPO_PUBLIC_RC_GOOGLE_KEY=
# RevenueCat Test Store key — one key for both platforms, no Apple/Google
# developer account needed. Used only when no platform key is set AND
# EXPO_PUBLIC_ENV is not production. Delete once the real store keys exist.
EXPO_PUBLIC_RC_TEST_KEY=
EXPO_PUBLIC_BRANCH_KEY=
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_MOCK_BACKEND=1
MOCK_BACKEND=1

# Supabase CLI / CI only. Do not expose these to the app bundle.
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets. Keep real values outside git.
XAI_API_KEY=dummy
XAI_MODEL=grok-4.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
BALANCED_MODEL_PROVIDER=gemini
GEMINI_BALANCED_MODEL=gemini-3.5-flash-lite
GEMINI_BALANCED_SECONDARY_MODEL=gemini-2.5-flash-lite
GEMINI_BALANCED_MAX_TOKENS=1000
GEMINI_TIMEOUT_MS=3500
OPENROUTER_API_KEY=
OPENROUTER_BALANCED_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_BALANCED_SECONDARY_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BALANCED_MAX_TOKENS=1000
OPENROUTER_BALANCED_HEDGE_DELAY_MS=0
OPENROUTER_TIMEOUT_MS=3500
# B8 — RevenueCat.
# RC_WEBHOOK_AUTH is the exact Authorization header value you set on the webhook
# in the RevenueCat dashboard; rc-webhook compares it in constant time and
# refuses every delivery when it is unset.
RC_WEBHOOK_AUTH=
# Secret (v1) API key, used ONLY by account-delete to unlink a subscriber.
# Never prefix this with EXPO_PUBLIC_ — it must never reach the app bundle.
RC_SECRET_API_KEY=
# Set to 1 on staging to accept RevenueCat Test Store webhook events. Leave unset
# in production: a Test Store event grants an entitlement with no money paid.
RC_ALLOW_TEST_STORE=
EXTRACT_BUDGET_MS=5000
GROK_TIMEOUT_MS=12000
GROK_RETRY_TIMEOUT_MS=1200
BREAKER_THRESHOLD=3
BREAKER_WINDOW_S=120
RETENTION_FINANCIAL_YEARS=5
APPLE_SIWA_TEAM_ID=
APPLE_SIWA_CLIENT_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APP_ATTEST_CONFIG=
DEVICECHECK_CONFIG=
PLAY_INTEGRITY_CONFIG=
