  "scripts": {
    "postinstall": "node ./scripts/patch-expo-modules-jsi-xcode-26-1.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "b1:app": "npm run typecheck && npm run lint",
    "contracts:sync": "node scripts/contracts-sync.js",
    "b1:backend": "npm run contracts:sync && node scripts/verify-b1-backend.js",
    "b1:db:reset": "supabase start -x vector && supabase db reset",
    "b1:db:verify": "node scripts/verify-b1-db.js",
    "b1:all": "npm run b1:app && npm run b1:backend",
    "b2:app": "npm run typecheck && npm run lint",
    "b2:backend": "npm run contracts:sync && node scripts/verify-b2-backend.js",
    "b2:db:reset": "supabase start -x vector && supabase db reset",
    "b2:db:verify": "node scripts/verify-b2-db.js",
    "b2:all": "npm run b2:app && npm run b2:backend",
    "supabase:staging:dry-run": "supabase db push --db-url \"$SUPABASE_DB_URL\" --dry-run",
    "supabase:staging:push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "supabase:prod:dry-run": "supabase db push --db-url \"$SUPABASE_DB_URL\" --dry-run",
    "supabase:prod:push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "gate": "node scripts/gate.js",
    "phase-lock": "node scripts/phase-lock.js",
    "b1:maestro": "JAVA_HOME=/opt/homebrew/opt/openjdk PATH=/opt/homebrew/opt/openjdk/bin:$HOME/.maestro/bin:$PATH maestro test .maestro/b1-app-smoke.yaml",
    "b3:app": "npm run typecheck && expo lint --no-cache && node scripts/verify-b3-app.js",
    "b3:backend": "npm run contracts:sync && node scripts/verify-b3-backend.js",
    "b3:db:verify": "node scripts/verify-b3-db.js",
    "b3:all": "npm run b3:app && npm run b3:backend && npm run b3:db:verify",
    "b4:app": "npm run typecheck && expo lint --no-cache && node scripts/verify-b4-app.js && npm run b4:preflight",
    "b4:preflight": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-b4-preflight.js",
    "b4:backend": "npm run contracts:sync && node scripts/verify-b4-backend.js",
    "b4:db:verify": "node scripts/verify-b4-db.js",
    "b4:device:verify": "node scripts/verify-b4-device.js",
    "b4:http:verify": "node scripts/verify-b4-http.js",
    "b4:golden": "node scripts/golden-b4.js",
    "b4:golden:verify": "node scripts/verify-b4-golden.js",
    "b4:all": "npm run b4:app && npm run b4:backend && npm run b1:db:verify && npm run b3:db:verify && npm run b4:db:verify",
    "b5:backend": "npm run contracts:sync && node scripts/verify-b5-backend.js",
    "b5:db:verify": "node scripts/verify-b5-db.js",
    "b5:http:verify": "node scripts/verify-b5-http.js",
    "b5:schedules:configure": "node scripts/configure-b5-schedules.js",
    "b5:schedules:verify": "node scripts/verify-b5-schedules.js",
    "b5:probe:verify": "node scripts/verify-b5-probe.js",
    "b5:breaker:verify": "node scripts/verify-b5-breaker-http.js",
    "b5:sweeper-cron:verify": "node scripts/verify-b5-sweeper-cron.js",
    "b5:gemini:fixtures": "node scripts/generate-b5-synthetic-golden.js",
    "b5:gemini:golden": "node scripts/golden-b5-gemini.js",
    "b5:gemini:aggregate": "node scripts/verify-b5-gemini-chunks.js",
    "b6:app": "npm run typecheck && expo lint --no-cache && node scripts/verify-b6-app.js",
    "b6:backend": "npm run contracts:sync && node scripts/verify-b6-backend.js",
    "b6:all": "npm run b6:app && npm run b6:backend",
    "b6:staging": "node scripts/verify-b6-staging.js",
    "b6:device:seed": "node scripts/seed-b6-device-test.js",
    "b6:device:attach": "node scripts/attach-b6-device-test.js",
    "b6:device:audit": "node scripts/audit-b6-device-sync.js",
    "b7:app": "npm run typecheck && expo lint --no-cache && node scripts/verify-b7-app.js",
    "b7:backend": "npm run contracts:sync && node scripts/verify-b7-backend.js",
    "b7:builders": "node scripts/b7-builders.js",
    "b7:db:verify": "node scripts/verify-b7-db.js",
    "b7:e2e": "node scripts/b7-e2e.js",
    "b7:fonts": "node scripts/build-export-fonts.js",
    "b7:all": "npm run b7:app && npm run b7:backend && npm run b7:builders",
    "b8:app": "npm run typecheck && expo lint --no-cache && node scripts/verify-b8-app.js",
    "b8:backend": "npm run contracts:sync && node scripts/verify-b8-backend.js",
    "b8:deno": "node scripts/verify-b8-deno.js",
    "b8:db:verify": "node scripts/verify-b8-db.js",
    "b8:all": "npm run b8:app && npm run b8:backend && npm run b8:deno && npm run b8:db:verify",
    "pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install",
    "prebuild:ios": "npx expo prebuild --platform ios && npm run pods"
  },
  "private": true
